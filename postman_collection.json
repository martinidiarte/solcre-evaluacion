              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"last_name\": \"Diaz\",\n  \"document\": \"12345678\",\n  \"dob\": \"1990-01-01\",\n  \"is_candidate\": false,\n  \"address\": \"Calle Falsa 123\",\n  \"telephone_number\": \"1122334455\",\n  \"sex\": \"Femenino\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/voter",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "voter"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener candidatos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/candidates",
              "host": [
                "{{base_url}}"
              ],
              "path": [
