                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/voters/12345678",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "voters",
                "12345678"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener todos los votantes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/voters",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "voters"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Ranking de candidatos más votados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/candidates/most-voted",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "candidates",
                "most-voted"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
